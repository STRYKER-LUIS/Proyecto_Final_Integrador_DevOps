# Entorno local (copiar a backend/.env)
NODE_ENV=development
PORT=4000
TRUST_PROXY=0

# Base de datos. Con docker-compose.dev.yml usar el puerto 5433.
DATABASE_URL="postgresql://incidenthub:incidenthub@localhost:5433/incidenthub?schema=public"
# Base de datos aislada para las pruebas E2E.
TEST_DATABASE_URL="postgresql://incidenthub:incidenthub@localhost:5433/incidenthub_test?schema=public"

# Genera secretos con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="reemplaza-este-secreto-por-uno-de-al-menos-32-caracteres"
JWT_REFRESH_SECRET="reemplaza-este-otro-secreto-por-uno-de-al-menos-32-caracteres"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Orígenes permitidos, separados por coma.
CORS_ORIGINS="http://localhost:5173,http://localhost:8080"
COOKIE_SECURE=false

# Niveles: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
