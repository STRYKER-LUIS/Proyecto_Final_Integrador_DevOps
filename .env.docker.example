# Copia este archivo a .env.docker o ejecuta `npm run docker:env`.
# Los valores __GENERATE_*__ se reemplazan automáticamente por secretos aleatorios.
POSTGRES_DB=incidenthub
POSTGRES_USER=incidenthub
POSTGRES_PASSWORD=__GENERATE_DB__

JWT_ACCESS_SECRET=__GENERATE_ACCESS__
JWT_REFRESH_SECRET=__GENERATE_REFRESH__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Origen público de la aplicación. Cámbialo si publicas el frontend en otro dominio.
CORS_ORIGINS=http://localhost:8080
COOKIE_SECURE=true
LOG_LEVEL=info
WEB_PORT=8080
