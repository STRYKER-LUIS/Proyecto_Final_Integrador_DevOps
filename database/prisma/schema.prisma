// IT Incident Hub - esquema de base de datos PostgreSQL
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  REPORTER
}

enum IncidentStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Impact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum Category {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCESS
  EMAIL
  OTHER
}

enum ActivityAction {
  CREATED
  UPDATED
  ASSIGNED
  STATUS_CHANGED
  COMMENTED
}

model User {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String           @db.VarChar(120)
  email              String           @unique @db.VarChar(180)
  passwordHash       String           @map("password_hash") @db.VarChar(255)
  role               Role             @default(REPORTER)
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  reportedIncidents  Incident[]       @relation("ReportedIncidents")
  assignedIncidents  Incident[]       @relation("AssignedIncidents")
  comments           Comment[]
  activities         Activity[]
  refreshSessions    RefreshSession[]

  @@index([role, isActive])
  @@map("users")
}

model Incident {
  id               Int            @id @default(autoincrement())
  title            String         @db.VarChar(200)
  description      String         @db.Text
  category         Category
  impact           Impact
  urgency          Urgency
  priority         Priority
  status           IncidentStatus @default(NEW)
  reporterId       String         @map("reporter_id") @db.Uuid
  assigneeId       String?        @map("assignee_id") @db.Uuid
  slaDueAt         DateTime       @map("sla_due_at")
  firstResponseAt  DateTime?      @map("first_response_at")
  resolvedAt       DateTime?      @map("resolved_at")
  closedAt         DateTime?      @map("closed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  reporter         User           @relation("ReportedIncidents", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee         User?          @relation("AssignedIncidents", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments         Comment[]
  activities       Activity[]

  @@index([status, createdAt])
  @@index([priority, status])
  @@index([assigneeId, status])
  @@index([reporterId, createdAt])
  @@index([slaDueAt, status])
  @@map("incidents")
}

model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  incidentId  Int      @map("incident_id")
  authorId    String   @map("author_id") @db.Uuid
  content     String   @db.Text
  isInternal  Boolean  @default(false) @map("is_internal")
  createdAt   DateTime @default(now()) @map("created_at")
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
  @@map("comments")
}

model Activity {
  id          String          @id @default(uuid()) @db.Uuid
  incidentId  Int             @map("incident_id")
  actorId     String?         @map("actor_id") @db.Uuid
  action      ActivityAction
  detail      String?         @db.VarChar(500)
  fromStatus  IncidentStatus? @map("from_status")
  toStatus    IncidentStatus? @map("to_status")
  createdAt   DateTime        @default(now()) @map("created_at")
  incident    Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor       User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("activities")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
